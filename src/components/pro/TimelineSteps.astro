---
import { emph, REVEAL } from '~/utils/pro';
// Light, sticky-heading timeline (alternative to the dark ProcessBand): heading stays while steps scroll past on a vertical rule.
interface Props { eyebrow?: string; title: string; intro?: string; steps: { title: string; text: string }[]; }
const { eyebrow, title, intro, steps } = Astro.props;
---
<section class="bg-surface-2 py-20 lg:py-28"><div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
  <div class="lg:sticky lg:top-28 lg:self-start">
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h2 class="h-display text-4xl text-ink sm:text-5xl" set:html={emph(title)} />
    {intro && <p class="mt-5 max-w-md leading-relaxed text-stone">{intro}</p>}
  </div>
  <ol class="relative border-l border-line pl-8 sm:pl-12">
    {steps.map((s, i) => (
      <li class:list={['relative pb-12 last:pb-0', REVEAL]}>
        <span class="absolute -left-[3.125rem] top-0 grid h-9 w-9 place-items-center bg-ink font-display text-sm text-white sm:-left-[4.125rem]">{i + 1}</span>
        <h3 class="font-display text-2xl text-ink sm:text-3xl">{s.title}</h3>
        <p class="mt-3 max-w-lg leading-relaxed text-stone">{s.text}</p>
      </li>
    ))}
  </ol>
</div></section>
