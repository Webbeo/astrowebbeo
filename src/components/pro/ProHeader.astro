---
import { Icon } from 'astro-icon/components';
import { getPermalink, getHomePermalink } from '~/utils/permalinks';
import { tel } from '~/utils/pro';
interface Props { name: string; mark?: string; sub?: string; phone: string; strap?: string; links: { text: string; href: string }[]; cta: { text: string; href: string }; }
const { name, mark, sub, phone, strap, links, cta } = Astro.props;
---
<header class="sticky top-0 z-50" transition:name="pro-header" transition:persist>
  <div class="hidden border-b border-white/10 bg-ink-deep text-white md:block">
    <div class="container-page micro flex h-9 items-center justify-between gap-6 text-white/65">
      <p>{strap}</p>
      <a href={tel(phone)} class="inline-flex items-center gap-2 transition-colors hover:text-signal-soft"><Icon name="tabler:phone" class="h-3.5 w-3.5" />{phone}</a>
    </div>
  </div>
  <div class="border-b border-line/80 bg-surface/95 backdrop-blur-md">
    <div class="container-page flex h-[72px] items-center justify-between gap-6 lg:h-[84px]">
      <a href={getHomePermalink()} aria-label={`${name} home`} class="group flex items-center gap-3 leading-none transition-opacity hover:opacity-80">
        {mark && <span class="grid h-10 w-10 place-items-center bg-ink text-signal-soft"><Icon name={mark} class="h-5 w-5" /></span>}
        <span class="flex flex-col"><span class="font-display text-[1.35rem] leading-none text-ink">{name}</span>{sub && <span class="micro mt-1.5 text-[0.56rem] text-ink/60">{sub}</span>}</span>
      </a>
      <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">{links.map((l) => <a href={l.href} class="nav-link">{l.text}</a>)}</nav>
      <div class="flex items-center gap-3">
        <a href={cta.href} class="pbtn hidden sm:inline-flex">{cta.text}</a>
        <a href={tel(phone)} aria-label={`Call ${phone}`} class="inline-flex h-11 w-11 items-center justify-center border border-line text-ink sm:hidden"><Icon name="tabler:phone" class="h-5 w-5" /></a>
        <button type="button" class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-ink lg:hidden" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu" data-nav-toggle><Icon name="tabler:menu-2" class="h-6 w-6" /></button>
      </div>
    </div>
  </div>
  <div id="mobile-nav" data-nav-panel hidden class="absolute inset-x-0 top-full min-h-[calc(100dvh-72px)] border-b border-line bg-surface shadow-lift lg:hidden">
    <nav aria-label="Mobile" class="container-page py-6">
      <ul class="divide-y divide-line">{links.map((l) => <li><a href={l.href} class="flex items-center justify-between py-5 font-display text-3xl text-ink">{l.text}<span aria-hidden="true" class="text-signal">→</span></a></li>)}</ul>
      <div class="mt-8 grid gap-3"><a href={cta.href} class="pbtn w-full">{cta.text}</a><a href={tel(phone)} class="pbtn-outline w-full text-ink">Call {phone}</a></div>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var b = document.querySelector('[data-nav-toggle]'), p = document.querySelector('[data-nav-panel]');
    if (!b || !p) return;
    b.addEventListener('click', function () { var o = p.hidden; p.hidden = !o; b.setAttribute('aria-expanded', String(o)); });
    document.addEventListener('astro:after-swap', function () { p.hidden = true; b.setAttribute('aria-expanded', 'false'); });
  })();
</script>
