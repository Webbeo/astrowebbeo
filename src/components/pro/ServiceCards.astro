---
import ProImage from './ProImage.astro';
import SectionHead from './SectionHead.astro';
interface Props { eyebrow?: string; title: string; intro?: string; href?: string; cta?: string; items: { title: string; summary: string; image: string; href: string }[]; }
const { eyebrow, title, intro, href, cta, items } = Astro.props;
---
<section class="bg-surface py-20 lg:py-28"><div class="container-page">
  <SectionHead {eyebrow} {title} {intro} {href} {cta} />
  <div class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((s, i) => (
      <a href={s.href} class="group block">
        <div class="relative aspect-[4/3] overflow-hidden bg-surface-2">
          <ProImage src={s.image} alt={s.title} sizes="(min-width:1024px) 400px, (min-width:640px) 50vw, 100vw" class="h-full w-full object-cover transition-transform duration-[900ms] ease-brand group-hover:scale-105" />
          <span class="micro absolute left-0 top-0 bg-surface px-3 py-2 text-ink">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <h3 class="h-display mt-5 text-2xl text-ink transition-colors group-hover:text-signal sm:text-[1.7rem]">{s.title}</h3>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-stone">{s.summary}</p>
        <span class="micro mt-4 inline-flex items-center gap-2 text-ink">Find out more <span aria-hidden="true" class="text-signal transition-transform group-hover:translate-x-1">→</span></span>
      </a>
    ))}
  </div>
</div></section>
