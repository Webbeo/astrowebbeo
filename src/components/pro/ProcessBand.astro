---
import SectionHead from './SectionHead.astro';
import { REVEAL } from '~/utils/pro';
interface Props { eyebrow?: string; title: string; intro?: string; steps: { title: string; text: string }[]; }
const { eyebrow, title, intro, steps } = Astro.props;
---
<section class="bg-ink py-20 text-white lg:py-28"><div class="container-page">
  <SectionHead {eyebrow} {title} {intro} dark />
  <ol class="mt-14 grid gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => <li class:list={['bg-ink p-7 lg:p-8', REVEAL]}><p class="font-display text-5xl text-signal-soft">{String(i + 1).padStart(2, '0')}</p><h3 class="mt-6 font-display text-2xl">{s.title}</h3><p class="mt-3 text-sm leading-relaxed text-white/65">{s.text}</p></li>)}
  </ol>
</div></section>
