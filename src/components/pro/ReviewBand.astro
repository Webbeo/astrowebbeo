---
import SectionHead from './SectionHead.astro';
interface Props { eyebrow?: string; title: string; reviews: { quote: string; name: string; place: string }[]; }
const { eyebrow, title, reviews } = Astro.props;
---
<section class="bg-surface-2 py-20 lg:py-28"><div class="container-page">
  <SectionHead {eyebrow} {title} />
  <div class="mt-12 grid gap-6 lg:grid-cols-3">
    {reviews.map((r) => (
      <figure class="flex flex-col bg-surface p-8 shadow-[0_1px_0_var(--color-line)]">
        <p class="font-display text-5xl leading-none text-signal" aria-hidden="true">“</p>
        <blockquote class="font-display -mt-2 flex-1 text-xl leading-snug text-ink">{r.quote}</blockquote>
        <figcaption class="micro mt-8 border-t border-line pt-5 text-ink">{r.name}<span class="block text-stone">{r.place}</span></figcaption>
      </figure>
    ))}
  </div>
</div></section>
