---
import Layout from '~/layouts/ProLayout.astro';
import PageHero from '~/components/pro/PageHero.astro';
import SplitFeature from '~/components/pro/SplitFeature.astro';
import ServiceCards from '~/components/pro/ServiceCards.astro';
import CtaBand from '~/components/pro/CtaBand.astro';
import { getPermalink } from '~/utils/permalinks';
import c from '~/data/content.json';
export function getStaticPaths() { return c.services.map((s) => ({ params: { slug: s.slug }, props: { service: s } })); }
const { service } = Astro.props;
const metadata = { title: service.title, description: service.summary };
const others = c.services.filter((s) => s.slug !== service.slug).slice(0, 3);
---
<Layout metadata={metadata}>
  <PageHero eyebrow={c.business.town} title={service.title} intro={service.intro} />
  <SplitFeature title={`What's *included*`} paragraphs={service.body} image={service.image} imageAlt={service.title}
    points={service.points.map((p) => ({ title: p, text: '' }))} href={getPermalink('/contact')} cta="Request a quote" />
  <ServiceCards title="Related *services*" items={others.map((s) => ({ title: s.title, summary: s.summary, image: s.image, href: getPermalink(`/services/${s.slug}`) }))} />
  <CtaBand title={c.cta.title} text={c.cta.text} primary={{ text: 'Get a quote', href: getPermalink('/contact') }} phone={c.business.phone} />
</Layout>
