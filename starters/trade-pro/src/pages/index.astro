---
import Layout from '~/layouts/ProLayout.astro';
import PhotoHero from '~/components/pro/PhotoHero.astro';
import TickerStrip from '~/components/pro/TickerStrip.astro';
import ServiceCards from '~/components/pro/ServiceCards.astro';
import SplitFeature from '~/components/pro/SplitFeature.astro';
import ProcessBand from '~/components/pro/ProcessBand.astro';
import ReviewBand from '~/components/pro/ReviewBand.astro';
import FaqList from '~/components/pro/FaqList.astro';
import CtaBand from '~/components/pro/CtaBand.astro';
import LocalBusinessSchema from '~/components/parts/LocalBusinessSchema.astro';
import { getPermalink } from '~/utils/permalinks';
import c from '~/data/content.json';
const b = c.business;
const metadata = { title: c.hero.title.replace(/\*/g, ''), description: b.description };
---
<Layout metadata={metadata}>
  <LocalBusinessSchema name={b.name} phone={b.phone} email={b.email} town={b.town} description={b.description} />
  <PhotoHero eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} image={c.hero.image} imageAlt={c.hero.imageAlt}
    primary={{ text: b.ctaText ?? 'Get a quote', href: getPermalink('/contact') }} secondary={{ text: 'Our services', href: getPermalink('/services') }} stats={c.hero.stats} />
  <TickerStrip items={c.ticker} />
  <SplitFeature eyebrow={c.intro.eyebrow} title={c.intro.title} paragraphs={c.intro.paragraphs} image={c.intro.image} imageAlt={c.intro.imageAlt}
    points={c.intro.points} href={getPermalink('/about')} cta={c.intro.ctaText} />
  <ServiceCards {...c.servicesSection} href={getPermalink('/services')} cta="All services"
    items={c.services.map((s) => ({ title: s.title, summary: s.summary, image: s.image, href: getPermalink(`/services/${s.slug}`) }))} />
  <ProcessBand {...c.process} />
  <ReviewBand eyebrow="Kind words" title="What customers say" reviews={c.reviews} />
  <FaqList eyebrow="Good to know" title="Common questions" items={c.faqs} />
  <CtaBand title={c.cta.title} text={c.cta.text} primary={{ text: b.ctaText ?? 'Get a quote', href: getPermalink('/contact') }} phone={b.phone} />
</Layout>
